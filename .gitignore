# =============================================================
#  TeraNova FPGA project - .gitignore
#  Place this file in C:\PLD (the root of the repository).
#  Rule of thumb: commit SOURCES, ignore anything the tools regenerate.
# =============================================================

# ---------- Vivado (S7_integration) ----------
# Keep: S7_integration.xpr, S7_integration.srcs/ (block design .bd, IP .xci,
#       constraints, sim sources), and the current interrupt_rerun.xsa
*.cache/
*.gen/
*.runs/
*.hw/
*.sim/
*.ip_user_files/
*.tmp/
.Xil/
NA/
*.jou
*.log
*.str
*.backup.*
*.bak
webtalk*
usage_statistics_webtalk.*
vivado_pid*.zip
hs_err_pid*.log
# Incremental-synthesis reference checkpoint (regenerated by synthesis)
*.srcs/utils_1/imports/
# ILA captures
*.ila

# Old hardware exports: only the current one is tracked.
# (Copies of all old ones are in backup\S7_integration_2026-10-07.)
S7_integration/*.xsa
!S7_integration/interrupt_rerun.xsa
S7_integration/*.zip

# ---------- Vitis unified IDE (S7_integration_vit) ----------
# Keep: vitis-comp.json, app src/, platform fsbl/pmufw/BSP sources + *.yaml,
#       interrupt_rerun_test/_ide/launch.json
# Workspace-level IDE state (per person, per machine)
S7_integration_vit/_ide/
.rigel_lopper/
# Build output
**/build/
**/export/
**/logs/
**/_ide/bitstream/
**/_ide/psinit/
**/_ide/hwspec.checksum
# Editor / indexer files generated by the IDE
.clangd
.cache/
.compile_commands/
compile_commands.json
.wsdata/
.analytics
.metadata/
.peers.ini
*.elf
*.elf.size
*.o
*.d

# ---------- Vitis HLS (hls/RAM_INTERFACE) ----------
# Keep: *.cpp, *.hpp, testbench, hls_config*.cfg, build_ip.bat, run_cosim.bat
# The packaged IP that the block design uses lives in ip_repo/ and IS committed.
hls/**/work*/
hls/**/*_log.txt
hls/**/dfx_runtime.txt
hls/**/*.zip
vitis_hls.log

# ---------- GHDL simulation (sim/) ----------
*.cf
*.ghw
*.vcd
*.fst
*.exe
sim/**/work/

# ---------- Local backups (git history replaces these) ----------
backup/
S7_integration_vit/backup/

# ---------- Editors / OS ----------
.vscode/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store
